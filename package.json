{
  "name": "leetcode-cli-tui",
  "version": "0.1.0",
  "description": "Work with LeetCode problems from your terminal: fetch, edit in a split-pane TUI, run and submit.",
  "license": "MIT",
  "author": "loneshaana",
  "homepage": "https://github.com/loneshaana/leetcode-cli-tui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loneshaana/leetcode-cli-tui.git"
  },
  "bugs": {
    "url": "https://github.com/loneshaana/leetcode-cli-tui/issues"
  },
  "keywords": [
    "leetcode",
    "cli",
    "tui",
    "terminal",
    "editor",
    "vim",
    "coding",
    "interview",
    "algorithms",
    "blessed"
  ],
  "bin": {
    "leetcode": "dist/index.js"
  },
  "main": "dist/index.js",
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w",
    "start": "node dist/index.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^22.9.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
